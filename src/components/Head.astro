---
import { site, channels } from '../data/site';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
  /** Path only; resolved against `site.url`. */
  path?: string;
}

const { title = site.title, description = site.description, path = '/' } = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: [site.nameArabic, site.handle],
  url: site.url,
  jobTitle: 'Software Developer',
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Muscat',
    addressCountry: 'OM',
  },
  knowsLanguage: ['ar', 'en'],
  knowsAbout: [
    'Software development',
    'Discord bot development',
    'FiveM server development',
    'Web application development',
    'Automation',
  ],
  sameAs: channels.filter((c) => c.id !== 'email').map((c) => c.href),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: site.lang,
  author: { '@type': 'Person', name: site.name },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#050505" />
<meta name="color-scheme" content="dark" />

<link rel="preload" href="/fonts/geist-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
<link
  rel="preload"
  href="/fonts/geist-mono-latin-variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="author" content={site.name} />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={JSON.stringify(person)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
