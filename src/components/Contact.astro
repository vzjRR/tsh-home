---
import SectionHead from './SectionHead.astro';
import { channels, contact, site } from '../data/site';

const arrow = `<path d="M1 8 8 1M8 1H2.4M8 1v5.6" stroke="currentColor" stroke-width="1.1"/>`;
const telegram = channels.find((c) => c.id === 'telegram');
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="shell">
    <SectionHead index="06" label="Contact" title={contact.heading} />

    <div class="contact">
      <div class="contact__lead">
        <p class="contact__body" data-reveal>{contact.body}</p>

        <p class="contact__actions" data-reveal style="--i:1">
          <a class="button button--primary" href="/contact" data-magnetic>
            <span>Send a message</span>
            <svg width="11" height="11" viewBox="0 0 9 9" fill="none" aria-hidden="true" set:html={arrow} />
          </a>
          {
            telegram && (
              <a class="button button--ghost" href={telegram.href} rel="me noopener">
                <span>Or reach me on Telegram</span>
              </a>
            )
          }
        </p>

        <p class="contact__note mono" data-reveal style="--i:2">
          <span class="contact__dot" aria-hidden="true"></span>
          {contact.availability} · {site.location} · {site.timezone}
        </p>
      </div>

      <ul class="elsewhere" data-reveal style="--i:1">
        <li class="mono elsewhere__title">Elsewhere</li>
        {
          channels.map((c) => (
            <li class="elsewhere__item">
              <a class="elsewhere__link" href={c.href} rel="me noopener">
                <span class="elsewhere__label">{c.label}</span>
                <span class="mono elsewhere__handle">{c.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(var(--space-7), 5vw, var(--space-9));
    align-items: start;
  }

  .contact__body {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-secondary);
    max-inline-size: 46ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .contact__note {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    color: var(--text-quiet);
  }

  .contact__dot {
    inline-size: 5px;
    block-size: 5px;
    border-radius: var(--radius-pill);
    background: var(--gold-200);
    box-shadow: 0 0 0 3px var(--gold-wash);
  }

  .elsewhere {
    border-block-start: var(--hairline) solid var(--line);
  }

  .elsewhere__title {
    padding-block: var(--space-4);
    color: var(--text-quiet);
    border-block-end: var(--hairline) solid var(--line);
  }

  .elsewhere__item {
    border-block-end: var(--hairline) solid var(--line);
  }

  .elsewhere__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    transition: padding-inline-start var(--dur-2) var(--ease-out);
  }

  .elsewhere__label {
    font-size: var(--step-0);
    letter-spacing: var(--tracking-tight);
    transition: color var(--dur-2) var(--ease-out);
  }

  .elsewhere__handle {
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    transition: color var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) {
    .elsewhere__link:hover,
    .elsewhere__link:focus-visible {
      padding-inline-start: var(--space-3);
    }
  }

  .elsewhere__link:hover .elsewhere__label,
  .elsewhere__link:focus-visible .elsewhere__label {
    color: var(--gold-100);
  }

  .elsewhere__link:hover .elsewhere__handle,
  .elsewhere__link:focus-visible .elsewhere__handle {
    color: var(--gold-200);
  }

  @media (min-width: 62rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
