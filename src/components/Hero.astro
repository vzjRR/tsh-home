---
import { site, contact } from '../data/site';
import { projects } from '../data/projects';
import { capabilities } from '../data/capabilities';
import { stack } from '../data/stack';

const languages = stack.find((g) => g.label === 'Languages')?.items.length ?? 0;

const stats = [
  { value: projects.length, label: 'Systems indexed', pad: true },
  { value: capabilities.length, label: 'Capability domains', pad: true },
  { value: languages, label: 'Languages written', pad: true },
  { value: null, label: site.location, text: site.timezone },
];
---

<section class="hero" id="top">
  <div class="shell hero__shell">
    <p class="hero__eyebrow">
      <span class="mono">{site.location} · {site.timezone}</span>
      <span class="mono hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {contact.availability}
      </span>
    </p>

    <h1 class="hero__name">
      <span class="hero__line"><span class="hero__line-in" style="--i:0">{site.nameLines[0]}</span></span>
      <span class="hero__line hero__line--light">
        <span class="hero__line-in" style="--i:1">{site.nameLines[1]}</span>
      </span>
      <span class="hero__handle mono" aria-hidden="true">{site.handle}</span>
    </h1>

    <div class="hero__body">
      <div class="hero__lead">
        <p class="mono hero__role" data-reveal style="--i:3">{site.role}</p>
        <p class="hero__statement" data-reveal style="--i:4">{site.statement}</p>
        <p class="hero__actions" data-reveal style="--i:5">
          <a class="button button--primary" href="#work" data-magnetic>
            <span>Explore the work</span>
            <svg width="11" height="11" viewBox="0 0 9 9" fill="none" aria-hidden="true">
              <path d="M1 8 8 1M8 1H2.4M8 1v5.6" stroke="currentColor" stroke-width="1.1"></path>
            </svg>
          </a>
          <a class="button button--ghost" href="#contact">
            <span>Start a conversation</span>
          </a>
        </p>
      </div>

      <dl class="hero__spec" data-reveal style="--i:5">
        <dt class="mono hero__spec-title">Practice</dt>
        {
          site.disciplines.map((d, i) => (
            <dd class="hero__spec-row">
              <span class="mono hero__spec-index">{String(i + 1).padStart(2, '0')}</span>
              <span>{d}</span>
            </dd>
          ))
        }
      </dl>
    </div>

    <ul class="hero__stats">
      {
        stats.map((s, i) => (
          <li class="hero__stat" data-reveal style={`--i:${6 + i}`}>
            <span class="hero__stat-value">
              {s.value !== null ? (
                <span data-count={s.value} data-pad={s.pad ? '2' : '0'}>
                  {String(s.value).padStart(2, '0')}
                </span>
              ) : (
                <span class="hero__stat-text">{s.text}</span>
              )}
            </span>
            <span class="mono hero__stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: calc(var(--header-h, 68px) + clamp(3.5rem, 8vw, 7rem)) clamp(3rem, 6vw, 5rem);
    min-block-size: min(96svh, 62rem);
    display: flex;
    align-items: center;
  }

  .hero__shell {
    inline-size: min(100% - (var(--gutter) * 2), var(--shell));
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
  }

  /* ------------------------------------------------------------- eyebrow -- */

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: var(--hairline) solid var(--line);
    color: var(--text-tertiary);
    animation: fade-in var(--dur-4) var(--ease-out) both;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-secondary);
  }

  .hero__dot {
    inline-size: 5px;
    block-size: 5px;
    border-radius: var(--radius-pill);
    background: var(--gold-200);
    box-shadow: 0 0 0 3px var(--gold-wash);
  }

  /* ---------------------------------------------------------------- name -- */

  .hero__name {
    position: relative;
    font-size: var(--display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin: 0;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-block-end: 0.06em;
    margin-block-end: -0.06em;
  }

  .hero__line-in {
    display: block;
    font-weight: 600;
    color: var(--paper-200);
    transform: translate3d(0, 105%, 0);
    animation: rise var(--dur-5) var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 60ms);
  }

  .hero__line--light .hero__line-in {
    font-weight: 200;
    color: var(--text-secondary);
  }

  .hero__handle {
    position: absolute;
    inset-block-end: 0.42em;
    inset-inline-end: 0.06em;
    font-size: var(--step--2);
    color: var(--text-quiet);
    letter-spacing: var(--tracking-wide);
    animation: fade-in var(--dur-4) var(--ease-out) 520ms both;
  }

  /* ---------------------------------------------------------------- body -- */

  .hero__body {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
    padding-block-start: clamp(var(--space-5), 3vw, var(--space-7));
    border-block-start: var(--hairline) solid var(--line);
  }

  .hero__role {
    color: var(--gold-200);
    margin-block-end: var(--space-5);
  }

  .hero__statement {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    max-inline-size: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  /* Stacked, they should agree on width rather than trail off raggedly. */
  @media (max-width: 30rem) {
    .hero__actions .button {
      flex: 1 0 100%;
      justify-content: space-between;
    }
  }

  /* ---------------------------------------------------------------- spec -- */

  .hero__spec {
    align-self: start;
    border: var(--hairline) solid var(--line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 60%),
      var(--ink-800);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .hero__spec-title {
    color: var(--text-quiet);
    padding-block-end: var(--space-3);
    border-block-end: var(--hairline) solid var(--line);
    margin-block-end: var(--space-1);
  }

  .hero__spec-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-secondary);
  }

  .hero__spec-index {
    color: var(--gold-400);
    font-size: 0.625rem;
  }

  /* --------------------------------------------------------------- stats -- */

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-block-start: var(--hairline) solid var(--line);
  }

  .hero__stat {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4) 0 0;
  }

  .hero__stat-value {
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
    color: var(--paper-300);
  }

  .hero__stat-text {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--text-secondary);
  }

  .hero__stat-label {
    color: var(--text-quiet);
    font-size: 0.625rem;
  }

  @keyframes rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line-in,
    .hero__handle,
    .hero__eyebrow {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  @media (min-width: 48rem) {
    .hero__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .hero__body {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 17rem);
      align-items: start;
      gap: clamp(var(--space-7), 5vw, var(--space-9));
    }
  }
</style>
