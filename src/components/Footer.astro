---
import Logo from './Logo.astro';
import { site, channels, nav } from '../data/site';

const year = new Date().getFullYear();
const compact = channels.filter((c) => c.compact);
---

<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__brand">
      <Logo size={48} />
      <p class="mono footer__place">{site.location} · {site.timezone}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="mono footer__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer__social">
      {
        compact.map((c) => (
          <li>
            <a class="mono footer__link" href={c.href} rel="me noopener">
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mono footer__legal">
      <span>© {year} {site.name}</span>
      <span aria-hidden="true">·</span>
      <span>{site.handle}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-block-start: var(--hairline) solid var(--line);
    padding-block: var(--space-7) var(--space-6);
    background:
      linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.012)),
      var(--ink-900);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-4);
  }

  .footer__place {
    color: var(--text-quiet);
  }

  .footer__nav ul,
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .footer__link {
    color: var(--text-tertiary);
    padding-block-end: 2px;
    border-block-end: var(--hairline) solid transparent;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--gold-100);
    border-block-end-color: var(--gold-edge);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--text-quiet);
    padding-block-start: var(--space-5);
    border-block-start: var(--hairline) solid var(--line);
  }

  @media (min-width: 62rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      column-gap: var(--space-8);
    }

    .footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
