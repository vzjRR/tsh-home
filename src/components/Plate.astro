---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: string;
}

const { project, index } = Astro.props;
const { diagram } = project;
---

<figure class="plate">
  <span class="plate__reg plate__reg--tl" aria-hidden="true"></span>
  <span class="plate__reg plate__reg--tr" aria-hidden="true"></span>
  <span class="plate__reg plate__reg--bl" aria-hidden="true"></span>
  <span class="plate__reg plate__reg--br" aria-hidden="true"></span>

  <div class="plate__top">
    <span class="plate__index">{index}</span>
    <span class="mono plate__kicker">{diagram ? 'Signal flow' : 'Plate'}</span>
  </div>

  {
    diagram && (
      <div class="diagram">
        {diagram.layers.map((layer, i) => (
          <div class="diagram__layer">
            {i > 0 && <span class="diagram__link" aria-hidden="true" />}
            <p class="mono diagram__label">{layer.label}</p>
            <ul class="diagram__nodes">
              {layer.nodes.map((node) => (
                <li class="diagram__node">{node}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  {diagram?.note && <figcaption class="diagram__note">{diagram.note}</figcaption>}

  <p class="plate__foot mono">
    <span>{project.category}</span>
    <span>{project.status}</span>
  </p>
</figure>

<style>
  .plate {
    position: relative;
    margin: 0;
    border: var(--hairline) solid var(--line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.022), transparent 55%),
      var(--ink-800);
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    overflow: hidden;
  }

  .plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line-faint) var(--hairline), transparent var(--hairline)),
      linear-gradient(90deg, var(--line-faint) var(--hairline), transparent var(--hairline));
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(120% 100% at 100% 0%, #000, transparent 68%);
    mask-image: radial-gradient(120% 100% at 100% 0%, #000, transparent 68%);
    pointer-events: none;
  }

  /* Content sits above the drafting grid; the registration marks position
     themselves against the plate and must stay out of the grid flow. */
  .plate > :not(.plate__reg) {
    position: relative;
  }

  /* Registration marks — the corners of a drawing, not decoration. */
  .plate__reg {
    position: absolute;
    inline-size: 9px;
    block-size: 9px;
    border: 0 solid var(--gold-edge);
  }

  .plate__reg--tl {
    inset-block-start: 10px;
    inset-inline-start: 10px;
    border-block-start-width: var(--hairline);
    border-inline-start-width: var(--hairline);
  }

  .plate__reg--tr {
    inset-block-start: 10px;
    inset-inline-end: 10px;
    border-block-start-width: var(--hairline);
    border-inline-end-width: var(--hairline);
  }

  .plate__reg--bl {
    inset-block-end: 10px;
    inset-inline-start: 10px;
    border-block-end-width: var(--hairline);
    border-inline-start-width: var(--hairline);
  }

  .plate__reg--br {
    inset-block-end: 10px;
    inset-inline-end: 10px;
    border-block-end-width: var(--hairline);
    border-inline-end-width: var(--hairline);
  }

  .plate__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .plate__index {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    background: var(--gold-leaf);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .plate__kicker {
    color: var(--text-quiet);
  }

  .plate__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: var(--hairline) solid var(--line);
    color: var(--text-quiet);
  }

  /* ------------------------------------------------------------- diagram -- */

  .diagram {
    display: grid;
    gap: var(--space-5);
  }

  .diagram__layer {
    position: relative;
    display: grid;
    gap: var(--space-3);
  }

  /* The connector between two layers, with the junction dot on it. */
  .diagram__link {
    position: absolute;
    inset-block-start: calc(var(--space-5) * -1);
    inset-inline-start: 11px;
    block-size: var(--space-5);
    inline-size: var(--hairline);
    background: linear-gradient(180deg, var(--gold-500), var(--line-strong));
  }

  .diagram__link::after {
    content: '';
    position: absolute;
    inset-block-start: calc(50% - 2px);
    inset-inline-start: -2px;
    inline-size: 5px;
    block-size: 5px;
    border-radius: var(--radius-pill);
    background: var(--gold-400);
  }

  .diagram__label {
    color: var(--text-quiet);
    font-size: 0.594rem;
  }

  .diagram__nodes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .diagram__node {
    padding: 0.42rem 0.7rem;
    border: var(--hairline) solid var(--line-strong);
    border-radius: var(--radius-1);
    background: rgba(255, 255, 255, 0.018);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* The first node of the first layer is the entry point. */
  .diagram__layer:first-child .diagram__node:first-child {
    border-color: var(--gold-edge);
    color: var(--gold-100);
  }

  .diagram__note {
    font-size: var(--step--1);
    color: var(--text-tertiary);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--hairline) solid var(--gold-edge);
  }
</style>
